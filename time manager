<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPG Time Management</title>
  <!-- Tailwind CSS & Chart.js CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-4 md:p-8 font-sans">

  <div class="max-w-4xl mx-auto space-y-6">

    <!-- ヘッダー＆勇者エリア -->
    <header class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl flex flex-col sm:flex-row items-center gap-6">
      <div class="relative flex-shrink-0">
        <!-- 勇者画像エリア（画像読込失敗時は自動で絵文字にフォールバック） -->
        <div class="w-20 h-20 bg-amber-500/10 border-2 border-amber-400 rounded-2xl flex items-center justify-center p-1 shadow-lg shadow-amber-500/10 animate-pulse overflow-hidden relative">
          <img src="image_5.png" alt="勇者" class="h-full w-auto object-contain" onerror="this.style.display='none'; document.getElementById('fallback-hero').style.display='flex';">
          <span id="fallback-hero" class="text-4xl absolute inset-0 items-center justify-center" style="display:none;">🧞‍♂️</span>
        </div>
        <span class="absolute -bottom-2 -right-2 bg-amber-500 text-slate-950 font-extrabold text-xs px-2.5 py-0.5 rounded-full shadow">
          Lv.<span id="player-level">1</span>
        </span>
      </div>
      <div class="flex-1 w-full text-center sm:text-left">
        <div class="bg-slate-700/60 border border-slate-600 rounded-xl p-3 relative mb-2">
          <p id="hero-quote" class="text-amber-300 text-sm font-bold">「今日の経験値を積み上げよう！」</p>
        </div>
        <h1 class="text-2xl font-black tracking-wide text-white">プレイヤーレベル: <span id="player-level-text" class="text-amber-400">1</span></h1>
      </div>
    </header>

    <!-- ストップウォッチ ＆ 日付指定手動入力 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- ストップウォッチカード -->
      <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg flex flex-col justify-between">
        <div>
          <h2 class="text-lg font-bold mb-3 text-emerald-400 flex items-center gap-2">
            <span>⏱️</span> リアルタイム計測（本日分）
          </h2>
          <div class="flex gap-2 mb-4">
            <select id="timer-category" class="bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-emerald-400 flex-1">
              <option value="study">勉強 (INT)</option>
              <option value="workout">運動 (STR)</option>
            </select>
          </div>
          <div class="text-center py-4 bg-slate-900/60 rounded-xl border border-slate-700/50 mb-4">
            <span id="timer-display" class="font-mono text-4xl font-black text-white">00:00:00</span>
          </div>
        </div>
        <div class="flex gap-3">
          <button id="btn-start" onclick="toggleTimer()" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl transition cursor-pointer">開始</button>
          <button id="btn-save-timer" onclick="saveTimerLog()" disabled class="flex-1 bg-slate-700 text-slate-400 font-bold py-2.5 rounded-xl transition cursor-not-allowed">本日分として保存</button>
        </div>
      </div>

      <!-- 手動入力カード（日付指定対応） -->
      <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-3">
            <h2 class="text-lg font-bold text-indigo-400 flex items-center gap-2">
              <span>📅</span> 活動記録（日付指定）
            </h2>
          </div>

          <!-- 日付選択 -->
          <div class="mb-3 bg-slate-900/80 p-2.5 rounded-xl border border-indigo-500/30 flex items-center gap-2">
            <label class="text-xs text-indigo-300 font-bold whitespace-nowrap">対象日付:</label>
            <input type="date" id="input-date" onchange="loadDateLogs()" class="bg-slate-800 border border-slate-600 rounded px-2 py-1 text-sm text-white flex-1 focus:outline-none focus:border-indigo-400">
          </div>

          <!-- 入力フォーム -->
          <form id="manual-form" class="grid grid-cols-2 gap-2 text-xs">
            <div>
              <label class="text-slate-400">勉強 (INT):</label>
              <input type="number" id="input-study" min="0" placeholder="分" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white">
            </div>
            <div>
              <label class="text-slate-400">運動 (STR):</label>
              <input type="number" id="input-workout" min="0" placeholder="分" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white">
            </div>
            <div>
              <label class="text-slate-400">本業 (MAIN):</label>
              <input type="number" id="input-main" min="0" placeholder="分" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white">
            </div>
            <div>
              <label class="text-slate-400">副業 (SIDE):</label>
              <input type="number" id="input-side" min="0" placeholder="分" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white">
            </div>
            <div>
              <label class="text-slate-400">睡眠・休息 (REC):</label>
              <input type="number" id="input-rec" min="0" placeholder="分" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white">
            </div>
            <div>
              <label class="text-slate-400">交際 (影響なし):</label>
              <input type="number" id="input-social" min="0" placeholder="分" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white">
            </div>
            <div class="col-span-2">
              <label class="text-rose-400 font-semibold">悪い娯楽・SNS (ペナルティ):</label>
              <input type="number" id="input-penalty" min="0" placeholder="分" class="w-full bg-slate-900 border border-rose-900/50 rounded p-1.5 text-white">
            </div>
          </form>
        </div>

        <!-- 保存ボタン -->
        <button onclick="saveManualLogs()" class="w-full mt-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 rounded-xl transition cursor-pointer">
          指定した日付で保存・更新
        </button>
      </div>

    </div>

    <!-- ５つのステータス詳細エリア -->
    <section class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg">
      <h3 class="text-md font-bold text-amber-400 mb-4 flex items-center gap-2">
        <span>📊</span> 5大ステータス詳細（レベル ＆ 累計EXP）
      </h3>
      <div id="status-details-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <!-- JSで動的生成 -->
      </div>
    </section>

    <!-- ダッシュボード：期間フィルター ＆ グラフ分析 -->
    <section class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg space-y-4">
      
      <!-- 最上部：期間選択フィルター -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-slate-700 pb-3">
        <h3 class="text-md font-bold text-slate-200 flex items-center gap-2">
          <span>📈</span> ダッシュボード分析
        </h3>
        
        <!-- 期間切替タブ -->
        <div class="flex flex-wrap items-center gap-1 bg-slate-900 p-1 rounded-xl border border-slate-700 text-xs">
          <button id="tab-today" onclick="changePeriodTab('today')" class="px-3 py-1.5 rounded-lg font-bold transition bg-amber-500 text-slate-950 cursor-pointer">1日</button>
          <button id="tab-week" onclick="changePeriodTab('week')" class="px-3 py-1.5 rounded-lg font-bold transition text-slate-400 hover:text-white cursor-pointer">今週</button>
          <button id="tab-month" onclick="changePeriodTab('month')" class="px-3 py-1.5 rounded-lg font-bold transition text-slate-400 hover:text-white cursor-pointer">今月</button>
          <button id="tab-custom" onclick="changePeriodTab('custom')" class="px-3 py-1.5 rounded-lg font-bold transition text-slate-400 hover:text-white cursor-pointer">期間指定</button>
        </div>
      </div>

      <!-- カスタム日付指定フォーム（タブ選択時のみ表示） -->
      <div id="custom-date-picker" class="hidden flex items-center gap-2 bg-slate-900/60 p-3 rounded-xl border border-slate-700 text-xs">
        <label class="text-slate-400">開始:</label>
        <input type="date" id="custom-start-date" onchange="renderCharts()" class="bg-slate-800 border border-slate-600 rounded px-2 py-1 text-white">
        <label class="text-slate-400">終了:</label>
        <input type="date" id="custom-end-date" onchange="renderCharts()" class="bg-slate-800 border border-slate-600 rounded px-2 py-1 text-white">
      </div>

      <!-- グラフ群 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <!-- レーダーチャート（5角形） -->
        <div class="flex flex-col items-center justify-center">
          <p class="text-xs text-amber-400 font-bold mb-2">5角形パラメータチャート</p>
          <div class="w-full aspect-square max-w-[240px]">
            <canvas id="radarChart"></canvas>
          </div>
        </div>

        <!-- 積み上げ棒グラフ ＆ 円グラフ -->
        <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-slate-400 text-center mb-1">行動時間の積み上げ推移 (h)</p>
            <canvas id="barChart" class="max-h-48"></canvas>
          </div>
          <div>
            <p class="text-xs text-slate-400 text-center mb-1">24時間時間配分シェア (%)</p>
            <canvas id="pieChart" class="max-h-48"></canvas>
          </div>
        </div>
      </div>
    </section>

    <!-- 称号・実績（トロフィー）一覧 -->
    <section class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg">
      <h3 class="text-md font-bold text-amber-400 mb-4 flex items-center gap-2">
        <span>🏆</span> 獲得称号・実績リスト
      </h3>
      <div id="trophy-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
        <!-- JSで動的生成 -->
      </div>
    </section>

  </div>

  <script>
    // --- 状態管理 ＆ 倍率定義 ---
