        { name: "No.012：[SIDE] 💡 起業家精神", desc: "SIDE(副業) Lv.10達成", unlocked: lvs.SIDE.lv >= 10 },
        { name: "No.013：[REC] 🌙 熟睡の匠", desc: "REC(回復) Lv.10達成", unlocked: lvs.REC.lv >= 10 },
        { name: "No.014：[LV] 🥈 銀の冒険者", desc: "プレイヤーレベル30達成", unlocked: playerLv >= 30 },
        { name: "No.015：[INT] 🔮 魔導士の素質", desc: "INT(勉強) Lv.30達成", unlocked: lvs.INT.lv >= 30 },
        { name: "No.016：[STR] ⚔️ 百戦錬磨", desc: "STR(運動) Lv.30達成", unlocked: lvs.STR.lv >= 30 },
        { name: "No.017：[MAIN] 🏢 ベテラン社員", desc: "MAIN(本業) Lv.30達成", unlocked: lvs.MAIN.lv >= 30 },
        { name: "No.018：[SIDE] 📈 敏腕実業家", desc: "SIDE(副業) Lv.30達成", unlocked: lvs.SIDE.lv >= 30 },
