      const totalSideMin = getCategoryTotalEXP('side') / (EXP_RATES.side || 1);
      const totalMainMin = getCategoryTotalEXP('main') / (EXP_RATES.main || 0.5);
      const totalRecMin = getCategoryTotalEXP('rec') / (EXP_RATES.rec || 0.5);
      const penaltyMinutes = logs.filter(l => l.category === 'penalty').reduce((sum, l) => sum + l.minutes, 0);

      const allTrophies = [
        { name: "No.001：[LOG] 🎖️ 最初の一歩", desc: "初めてログを保存した", unlocked: logs.length > 0 },
