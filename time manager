    let currentTab = 'today';

    const EXP_RATES = {
      study: 1.0,     // INT
      workout: 1.5,   // STR
      main: 0.5,      // MAIN (本業)
      side: 1.0,      // SIDE (副業)
      rec: 0.5,       // REC (回復)
      social: 0,      // ステータス影響なし
      penalty: -2.0   // ペナルティ
    };

    // 勇者の名言・金言30選
    const HERO_QUOTES = [
