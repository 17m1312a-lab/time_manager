    // --- 期間切り替えタブ処理 ---
    function changePeriodTab(tab) {
      currentTab = tab;
      ['today', 'week', 'month', 'custom'].forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        if (btn) {
          if (t === tab) {
            btn.className = 'px-3 py-1.5 rounded-lg font-bold transition bg-amber-500 text-slate-950 cursor-pointer';
          } else {
            btn.className = 'px-3 py-1.5 rounded-lg font-bold transition text-slate-400 hover:text-white cursor-pointer';
          }
        }
      });

      const customPicker = document.getElementById('custom-date-picker');
      if (customPicker) {
        if (tab === 'custom') {
          customPicker.classList.remove('hidden');
        } else {
          customPicker.classList.add('hidden');
        }
      }

      renderCharts();
    }

    // 日付範囲取得関数
    function getDateRange() {
      const today = new Date();
      const formatDate = d => d.toISOString().split('T')[0];

      if (currentTab === 'today') {
        const sel = document.getElementById('input-date').value || formatDate(today);
        return { start: sel, end: sel, dates: [sel] };
      } else if (currentTab === 'week') {
        const dates = [];
        for (let i = 6; i >= 0; i--) {
          const d = new Date();
          d.setDate(today.getDate() - i);
          dates.push(formatDate(d));
        }
        return { start: dates[0], end: dates[6], dates: dates };
      } else if (currentTab === 'month') {
        const dates = [];
        for (let i = 29; i >= 0; i--) {
          const d = new Date();
          d.setDate(today.getDate() - i);
          dates.push(formatDate(d));
        }
        return { start: dates[0], end: dates[29], dates: dates };
      } else if (currentTab === 'custom') {
        const startDateStr = document.getElementById('custom-start-date').value || formatDate(today);
        const endDateStr = document.getElementById('custom-end-date').value || formatDate(today);
        
        const startDate = new Date(startDateStr);
        const endDate = new Date(endDateStr);
        const dates = [];
        
        for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
          dates.push(formatDate(new Date(d)));
        }
        
        return { start: startDateStr, end: endDateStr, dates: dates };
      }
    }

    // --- 日付変更時の既存データ読込 ---
    function loadDateLogs() {
      const selectedDate = document.getElementById('input-date').value;
      const categories = ['study', 'workout', 'main', 'side', 'rec', 'social', 'penalty'];

      categories.forEach(cat => {
        const inputElem = document.getElementById(`input-${cat}`);
        if (inputElem) {
          const totalForCat = logs
            .filter(l => l.date === selectedDate && l.category === cat)
            .reduce((sum, l) => sum + l.minutes, 0);
          inputElem.value = totalForCat > 0 ? totalForCat : '';
        }
      });

      if (currentTab === 'today') renderCharts();
    }

    // --- ストップウォッチ機能 ---
    let timerInterval = null;
    let timerSeconds = 0;

    function toggleTimer() {
      const btn = document.getElementById('btn-start');
      const saveBtn = document.getElementById('btn-save-timer');
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
        btn.innerText = '再開';
        btn.classList.replace('bg-rose-600', 'bg-emerald-600');
        saveBtn.disabled = false;
        saveBtn.classList.replace('bg-slate-700', 'bg-amber-600');
        saveBtn.classList.replace('text-slate-400', 'text-white');
        saveBtn.classList.remove('cursor-not-allowed');
      } else {
        timerInterval = setInterval(() => {
          timerSeconds++;
          const h = String(Math.floor(timerSeconds / 3600)).padStart(2, '0');
          const m = String(Math.floor((timerSeconds % 3600) / 60)).padStart(2, '0');
          const s = String(timerSeconds % 60).padStart(2, '0');
          document.getElementById('timer-display').innerText = `${h}:${m}:${s}`;
        }, 1000);
        btn.innerText = '一時停止';
        btn.classList.replace('bg-emerald-600', 'bg-rose-600');
      }
    }

    function saveTimerLog() {
      const category = document.getElementById('timer-category').value;
      const minutes = Math.max(1, Math.round(timerSeconds / 60));
      const today = new Date().toISOString().split('T')[0];

      logs.push({ date: today, category: category, minutes: minutes });
      localStorage.setItem('rpg_time_logs', JSON.stringify(logs));

      timerSeconds = 0;
      document.getElementById('timer-display').innerText = '00:00:00';
      document.getElementById('btn-save-timer').disabled = true;
      document.getElementById('btn-save-timer').classList.replace('bg-amber-600', 'bg-slate-700');
      document.getElementById('btn-start').innerText = '開始';

      loadDateLogs();
      updatePlayerLevel();
      alert(`本日分として計測ログ（${minutes}分）を保存しました！`);
    }

    // --- 日付指定保存 ---
    function saveManualLogs() {
      const targetDate = document.getElementById('input-date').value;
      if (!targetDate) return alert('日付を選択してください。');

      const categories = ['study', 'workout', 'main', 'side', 'rec', 'social', 'penalty'];
      logs = logs.filter(l => l.date !== targetDate);

      categories.forEach(cat => {
        const val = parseInt(document.getElementById(`input-${cat}`).value);
        if (val && val > 0) {
          logs.push({ date: targetDate, category: cat, minutes: val });
        }
      });

      localStorage.setItem('rpg_time_logs', JSON.stringify(logs));
      renderCharts();
      updatePlayerLevel();
      alert(`${targetDate} の記録を保存・更新しました！`);
    }

    // --- Chart.js グラフ描画 ---
    let radarChart, barChart, pieChart;

    function renderCharts() {
      const lvs = getSkillLevels();
      const range = getDateRange();

      // 1. レーダーチャート（5角形）
      const ctxRadar = document.getElementById('radarChart');
      if (ctxRadar) {
        if (radarChart) radarChart.destroy();
        radarChart = new Chart(ctxRadar.getContext('2d'), {
          type: 'radar',
          data: {
            labels: ['INT', 'MAIN', 'SIDE', 'STR', 'REC'],
            datasets: [{
              data: [lvs.INT.lv, lvs.MAIN.lv, lvs.SIDE.lv, lvs.STR.lv, lvs.REC.lv],
              backgroundColor: 'rgba(245, 158, 11, 0.25)',
              borderColor: '#f59e0b',
              pointBackgroundColor: '#f59e0b'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { r: { min: 0, ticks: { display: false }, grid: { color: '#334155' }, angleLines: { color: '#334155' } } }
          }
        });
      }

      // 2. 期間内のログ抽出と集計
      const periodLogs = logs.filter(l => l.date >= range.start && l.date <= range.end);
      const catMinutes = { study:0, workout:0, main:0, side:0, rec:0, social:0, penalty:0 };
      periodLogs.forEach(l => { if (catMinutes[l.category] !== undefined) catMinutes[l.category] += l.minutes; });
      
      const dayCount = range.dates.length || 1;
      const totalCapacityMinutes = 1440 * dayCount;
      const loggedTotal = Object.values(catMinutes).reduce((a,b)=>a+b, 0);
      const otherMinutes = Math.max(0, totalCapacityMinutes - loggedTotal);

      // 3. シェア円グラフ
      const ctxPie = document.getElementById('pieChart');
      if (ctxPie) {
        if (pieChart) pieChart.destroy();
        pieChart = new Chart(ctxPie.getContext('2d'), {
          type: 'doughnut',
          data: {
            labels: ['勉強', '運動', '本業', '副業', '回復', '交際', 'SNS', 'その他'],
            datasets: [{
              data: [
                catMinutes.study, catMinutes.workout, catMinutes.main, 
                catMinutes.side, catMinutes.rec, catMinutes.social, 
                catMinutes.penalty, otherMinutes
              ],
              backgroundColor: ['#10b981', '#f97316', '#3b82f6', '#8b5cf6', '#06b6d4', '#ec4899', '#f43f5e', '#64748b']
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
          }
        });
      }

      // 4. 積み上げ棒グラフ
      const ctxBar = document.getElementById('barChart');
      if (ctxBar) {
        const barLabels = range.dates.map(d => d.slice(5)); // MM-DD表示
        const datasets = [
          { label: '勉強', key: 'study', color: '#10b981' },
          { label: '運動', key: 'workout', color: '#f97316' },
          { label: '本業', key: 'main', color: '#3b82f6' },
          { label: '副業', key: 'side', color: '#8b5cf6' },
          { label: '回復', key: 'rec', color: '#06b6d4' }
        ].map(item => ({
          label: item.label,
          backgroundColor: item.color,
          data: range.dates.map(date => {
            const dayLogs = logs.filter(l => l.date === date && l.category === item.key);
            return dayLogs.reduce((sum, l) => sum + l.minutes, 0) / 60;
          })
        }));

        if (barChart) barChart.destroy();
        barChart = new Chart(ctxBar.getContext('2d'), {
          type: 'bar',
          data: { labels: barLabels, datasets: datasets },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { x: { stacked: true }, y: { stacked: true, max: 24 } },
            plugins: { legend: { display: false } }
          }
        });
      }
    }

    // 初期起動処理（DOM構築完了後に安全に実行）
    document.addEventListener('DOMContentLoaded', () => {
      const today = new Date().toISOString().split('T')[0];
      
      const elInputDate = document.getElementById('input-date');
      const elStartDate = document.getElementById('custom-start-date');
      const elEndDate = document.getElementById('custom-end-date');
      const elHeroQuote = document.getElementById('hero-quote');

      if (elInputDate) elInputDate.value = today;
      if (elStartDate) elStartDate.value = today;
      if (elEndDate) elEndDate.value = today;
      if (elHeroQuote) elHeroQuote.innerText = HERO_QUOTES[Math.floor(Math.random() * HERO_QUOTES.length)];

      loadDateLogs();
      updatePlayerLevel();
      renderCharts();
    });
  </script>
</body>
</html>
