      "「Anger is caused by lack of learning.」",
      "「目先の誘惑を断ち切った夜、君のレベルは一段階跳ね上がる。」",
      "「記録をつける。それだけで、君は自分の人生の主人公になれる。」",
      "「試練は君を壊すためではなく、より強靭にするために訪れる。」",
      "「今日という一日は、二度と手に入らない。」",
      "「信じろ。毎日の継続は、いつか必ず伝説の景色を見せてくれる。」"
    ];

    // --- 累計EXP・スキルレベル計算 ---
    function getCategoryTotalEXP(category) {
      return logs.filter(l => l.category === category).reduce((sum, l) => {
        const rate = EXP_RATES[category] || 0;
        return sum + (l.minutes * rate);
      }, 0);
    }

    function calcSkillLevel(exp) {
      if (!exp || exp <= 0) return 1;
      return Math.floor((1 + Math.sqrt(1 + (8 * exp) / 100)) / 2);
    }

    function getReqEXPForLevel(level) {
      if (level <= 1) return 0;
      return ((level - 1) * level / 2) * 100;
    }

    function getSkillLevels() {
      const expInt = getCategoryTotalEXP('study');
      const expMain = getCategoryTotalEXP('main');
      const expSide = getCategoryTotalEXP('side');
      const expStr = getCategoryTotalEXP('workout');
      const expRec = getCategoryTotalEXP('rec');

      return {
        INT: { lv: calcSkillLevel(expInt), exp: Math.max(0, expInt) },
        MAIN: { lv: calcSkillLevel(expMain), exp: Math.max(0, expMain) },
        SIDE: { lv: calcSkillLevel(expSide), exp: Math.max(0, expSide) },
        STR: { lv: calcSkillLevel(expStr), exp: Math.max(0, expStr) },
        REC: { lv: calcSkillLevel(expRec), exp: Math.max(0, expRec) }
      };
    }

    function updatePlayerLevel() {
      const lvs = getSkillLevels();
      const avgLevel = Math.floor((lvs.INT.lv + lvs.MAIN.lv + lvs.SIDE.lv + lvs.STR.lv + lvs.REC.lv) / 5);
      
      const elLv = document.getElementById('player-level');
      const elLvText = document.getElementById('player-level-text');
      if (elLv) elLv.innerText = avgLevel;
      if (elLvText) elLvText.innerText = avgLevel;

      renderStatusDetails();
      renderTrophies(avgLevel);
    }

    // --- ５つのステータス詳細カード描画 ---
    function renderStatusDetails() {
      const lvs = getSkillLevels();
      const stats = [
        { key: 'INT', name: '勉強 (INT)', icon: '📚', data: lvs.INT },
        { key: 'MAIN', name: '本業 (MAIN)', icon: '💼', data: lvs.MAIN },
        { key: 'SIDE', name: '副業 (SIDE)', icon: '🚀', data: lvs.SIDE },
        { key: 'STR', name: '運動 (STR)', icon: '⚔️', data: lvs.STR },
        { key: 'REC', name: '回復 (REC)', icon: '🛌', data: lvs.REC }
      ];

      const container = document.getElementById('status-details-container');
      if (!container) return;

      container.innerHTML = stats.map(s => {
        const curLv = s.data.lv;
        const curExp = Math.round(s.data.exp);
        const curLevelReq = getReqEXPForLevel(curLv);
        const nextLevelReq = getReqEXPForLevel(curLv + 1);
        
        const expInCurrentLevel = curExp - curLevelReq;
        const reqForNextLevel = nextLevelReq - curLevelReq;
        const progress = Math.min(100, Math.max(0, Math.floor((expInCurrentLevel / reqForNextLevel) * 100))) || 0;
        
        // 次のレベルまでの残りEXP計算
        const remainingExp = Math.max(0, nextLevelReq - curExp);

        return `
          <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-700 text-xs flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="font-bold text-slate-200">${s.icon} ${s.name}</span>
                <span class="font-black text-amber-400">Lv.${curLv}</span>
              </div>
              <p class="text-[10px] text-slate-400 mb-2">累計: ${curExp} EXP</p>
            </div>
            <div>
              <div class="w-full bg-slate-800 rounded-full h-1.5 border border-slate-700 overflow-hidden mb-1">
                <div class="bg-amber-400 h-1.5 rounded-full" style="width: ${progress}%"></div>
              </div>
              <p class="text-[9px] text-slate-400 text-right">次Lvまであと ${remainingExp} EXP</p>
            </div>
          </div>
        `;
      }).join('');
    }

    // --- 連続日数や条件判定用の補助関数 ---
    function checkConsecutiveDays(category, minMinutes, requiredDays) {
      const uniqueDates = [...new Set(logs.map(l => l.date))].sort();
      let currentStreak = 0;
      let maxStreak = 0;

      for (let date of uniqueDates) {
        const dayTotal = logs
          .filter(l => l.date === date && l.category === category)
          .reduce((sum, l) => sum + l.minutes, 0);

        if (dayTotal >= minMinutes) {
          currentStreak++;
          if (currentStreak > maxStreak) maxStreak = currentStreak;
        } else {
          currentStreak = 0;
        }
      }
      return maxStreak >= requiredDays;
    }

    function checkDailyRecExceed(targetMinutes) {
      const dateMap = {};
      logs.forEach(l => {
        if (l.category === 'rec') {
          dateMap[l.date] = (dateMap[l.date] || 0) + l.minutes;
        }
      });
      return Object.values(dateMap).some(mins => mins >= targetMinutes);
    }

 // --- 100個の称号・実績描画（No.001〜No.100 統一デザイン版） ---
