        { name: "No.006：[SIDE] 🪙 商人の卵", desc: "SIDE(副業) Lv.5達成", unlocked: lvs.SIDE.lv >= 5 },
        { name: "No.007：[REC] ☕ 休日の賢者", desc: "REC(回復) Lv.5達成", unlocked: lvs.REC.lv >= 5 },
        { name: "No.008：[LV] 🥉 銅の冒険者", desc: "プレイヤーレベル10達成", unlocked: playerLv >= 10 },
